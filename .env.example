# =====================================================================
# AYUConnect - Environment Configuration Example
# Copy this file to `.env` for local development. NEVER commit `.env`.
# =====================================================================

# Flask environment: development | testing | production
FLASK_ENV=development

# Flask secret key (used for sessions / signing). Change in production.
SECRET_KEY=change_me

# Database URL.
# Local development fallback (no MySQL required):
#   sqlite:///ayuconnect_dev.db
# MySQL (recommended):
#   mysql+pymysql://user:password@localhost:3306/ayuconnect
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/ayuconnect

# JWT secret key (used to sign access tokens). Change in production.
JWT_SECRET_KEY=change_me

# Token expiry in minutes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=720

# CORS allowed origins (comma separated). In production set to your
# frontend origin, e.g. https://app.ayuconnect.example
CORS_ORIGINS=http://localhost:5173

# AI provider: demo | external
AI_PROVIDER=demo

# AI API key (used only when AI_PROVIDER=external). Never expose to frontend.
AI_API_KEY=

# Backend port
PORT=5000

# ---------- Frontend (Vite) ----------
# Base URL used by the frontend axios client for the Flask API.
VITE_API_BASE_URL=http://localhost:5000/api